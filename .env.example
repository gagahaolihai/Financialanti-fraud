# =============================================
# 反诈卫士 - 环境变量配置示例
# 复制此文件为 .env 并修改配置
# cp .env.example .env
# =============================================

# ---------- 基础 ----------
DEBUG=false
PORT=5000
HOST=0.0.0.0
SECRET_KEY=your-super-secret-key-here-change-in-production

# ---------- 数据库 ----------
DATABASE_URL=sqlite:///data/antifraud.db

# ---------- 加密 ----------
ENCRYPTION_KEY=your-32-byte-encryption-key-here!!!!
ENCRYPT_DATA=true
DATA_DIR=data

# ---------- 安全 ----------
ENABLE_RATE_LIMIT=true
RATE_LIMIT_PER_MINUTE=30
JWT_SECRET=your-jwt-secret-change-this
JWT_EXPIRY_HOURS=24
CORS_ORIGINS=*
HTTPS_ONLY=false

# ---------- LLM集成 ----------
LLM_ENABLED=false
LLM_PROVIDER=deepseek
LLM_API_KEY=sk-your-api-key-here
LLM_API_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_FALLBACK_TO_RULES=true

# ---------- 混合云部署 ----------
CLOUD_DEPLOYMENT=single
DATA_CROSS_REGION_ENCRYPT=true
# TLS_CERT_PATH=/etc/ssl/certs/cert.pem
# TLS_KEY_PATH=/etc/ssl/private/key.pem

# ---------- 日志 ----------
LOG_LEVEL=INFO
LOG_FILE=logs/antifraud.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# ---------- 管理后台 ----------
ADMIN_USERNAME=admin
# ADMIN_PASSWORD_HASH=  # 首次启动后通过API设置

# ---------- 合规 ----------
DATA_RETENTION_DAYS=90
ENABLE_AUDIT_LOG=true
GDPR_COMPLIANCE=false

# ---------- v3.0 运行模式 ----------
# SAFE_MODE=true: 纯规则引擎，零网络，100%稳定（比赛兜底）
SAFE_MODE=false
# NLP_OFFLINE_MODE=true: 使用本地模型，不从网络下载
NLP_OFFLINE_MODE=true
